DEBUG=True
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:3000

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=CRACK TCG <tienda@cracktcg.com>
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 — imágenes del catálogo de cartas
# Dashboard de Cloudflare → R2. El Account ID está arriba a la derecha;
# las claves se crean en "Manage R2 API Tokens" (permiso: Object Read & Write).
# R2_PUBLIC_BASE_URL es el dominio público del bucket: se habilita en
# el bucket → Settings → Public access → Connect a domain.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=crack-catalog
# R2_PUBLIC_BASE_URL=https://s3.cracktcg.com

# Database (production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional Render hostname
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# Upstash Redis (production rate-limit/cache)
# Use the same variable names as DeltaBackend.
# Set USE_UPSTASH=true in production.
# DEBUG=False
# USE_UPSTASH=false
# GLOBAL_API_RATELIMIT_ENABLED=true
# GLOBAL_API_RATELIMIT_READ_RATE=120/m
# GLOBAL_API_RATELIMIT_WRITE_RATE=30/m
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# eBay Browse API — calculadora de importación (/compra-ebay)
# Keyset de developer.ebay.com: EBAY_CLIENT_ID es el App ID (Client ID) y
# EBAY_CLIENT_SECRET el Cert ID (Client Secret).
# EBAY_ENV: production | sandbox.
# Sin credenciales cargadas la cotización entra sola en modo demo y responde
# con datos de ejemplo, así el flujo se puede probar completo. EBAY_MOCK=true
# fuerza ese modo aunque haya credenciales.
# Comisión, tax, envíos y ZIP del courier NO van acá: se editan en el admin,
# en Importación eBay → Configuración eBay.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_ENV=production
# EBAY_MOCK=false
